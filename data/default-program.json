{
  "id": "volt-strength-resilience-v2",
  "name": "VOLT Full Body — Strength & Resilience",
  "description": "Four-workout rolling full-body program. Complete A, B, C, D in order, regardless of the day or week.",
  "version": 2,
  "rotation": "rolling",
  "goals": [
    "General strength",
    "Strong and resilient knees",
    "Glute and posterior-chain strength",
    "Back and trunk stability",
    "Pelvic control and bracing",
    "Shoulder development",
    "ATG-style long-range strength",
    "Compatibility with BJJ and yoga"
  ],
  "notes": "Main compounds: 1–3 reps in reserve. Accessories: 0–2 reps in reserve. Avoid grinding every set. Reduce accessory volume first when recovery is poor.",
  "progression": {
    "method": "double progression",
    "instructions": "Keep the same weight until all prescribed working sets reach the top of the repetition range with good technique. Then increase the weight slightly.",
    "atgSplitSquat": "Progress control, then range of motion, then reduced assistance, then external load."
  },
  "recovery": {
    "instructions": "After difficult BJJ sessions, reduce load if needed, perform two high-quality compound sets instead of three, keep 2–3 reps in reserve, and remove optional accessories first."
  },
  "days": [
    {
      "id": "day-a",
      "name": "A — Squat Strength + Upper Back + Lateral Delts",
      "priorityExercises": 5,
      "focus": "Heavy knee-dominant strength.",
      "warmup": [
        {
          "id": "a-w01",
          "name": "Backward Resisted Treadmill or Sled Drag",
          "sets": 1,
          "reps": "240",
          "type": "time",
          "notes": "4 minutes at moderate resistance. Smooth backward steps. Warm the quads without fatigue."
        },
        {
          "id": "a-w02",
          "name": "90/90 Hip Switches",
          "sets": 1,
          "reps": "5-6",
          "type": "reps",
          "perSide": true
        },
        {
          "id": "a-w03",
          "name": "Half-Kneeling Hip-Flexor Stretch",
          "sets": 1,
          "reps": "20-30",
          "type": "time",
          "perSide": true
        },
        {
          "id": "a-w04",
          "name": "Glute Bridge",
          "sets": "1-2",
          "reps": "10",
          "type": "reps",
          "notes": "Hold the top for 2 seconds."
        },
        {
          "id": "a-w05",
          "name": "Banded Lateral Walk",
          "sets": 1,
          "reps": "10",
          "type": "reps",
          "perSide": true,
          "notes": "10 steps each direction."
        },
        {
          "id": "a-w06",
          "name": "Dead Bug",
          "sets": 1,
          "reps": "6",
          "type": "reps",
          "perSide": true
        },
        {
          "id": "a-w07",
          "name": "Squat Ramp-Up Sets",
          "sets": "2-4",
          "reps": "3-8",
          "type": "reps",
          "notes": "Progressively increase the load toward your working weight without fatigue."
        }
      ],
      "exercises": [
        {
          "id": "a-01",
          "name": "Front Squat or Hack Squat",
          "alternatives": ["Front Squat", "Hack Squat"],
          "sets": 3,
          "reps": "5-8",
          "rest": 150,
          "type": "reps",
          "notes": "Main knee-dominant strength exercise. Keep 1–3 reps in reserve."
        },
        {
          "id": "a-02",
          "name": "Romanian Deadlift",
          "sets": 2,
          "reps": "6-10",
          "rest": 120,
          "type": "reps",
          "notes": "Brace before moving. Keep ribs stacked over pelvis. Push hips backwards and keep the weight close. Stop when hamstring tension limits further hip movement. Do not extend or round the lower back to gain extra range."
        },
        {
          "id": "a-03",
          "name": "Incline Dumbbell Press",
          "sets": 3,
          "reps": "6-10",
          "rest": 90,
          "type": "reps",
          "notes": "Use controlled repetitions."
        },
        {
          "id": "a-04",
          "name": "Chin-Up or Assisted Chin-Up",
          "alternatives": ["Chin-Up", "Assisted Chin-Up"],
          "sets": 3,
          "reps": "5-8",
          "rest": 120,
          "type": "reps",
          "notes": "Record assistance consistently."
        },
        {
          "id": "a-05",
          "name": "Chest-Supported Row",
          "sets": 2,
          "reps": "8-12",
          "rest": 90,
          "type": "reps",
          "notes": "Keep your chest supported and control each repetition."
        },
        {
          "id": "a-06",
          "name": "Lateral Raise or Lu Raise",
          "alternatives": ["Lateral Raise", "Lu Raise"],
          "sets": 2,
          "reps": "12-20",
          "rest": 60,
          "type": "reps"
        },
        {
          "id": "a-07",
          "name": "Tibialis Raise",
          "sets": 2,
          "reps": "15-25",
          "rest": 60,
          "type": "reps"
        },
        {
          "id": "a-08",
          "name": "Standing Calf Raise",
          "sets": 2,
          "reps": "10-15",
          "rest": 60,
          "type": "reps"
        },
        {
          "id": "a-09",
          "name": "Suitcase Carry",
          "sets": 2,
          "reps": "20-40",
          "rest": 60,
          "type": "distance",
          "unit": "m",
          "perSide": true,
          "notes": "20–40 metres per side. Stay upright and resist leaning."
        }
      ]
    },
    {
      "id": "day-b",
      "name": "B — Hinge Strength + ATG Knee Work + Overhead Strength",
      "priorityExercises": 5,
      "focus": "Heavy hinge strength, controlled knee range, overhead strength and trunk stability.",
      "warmup": [
        {
          "id": "b-w01",
          "name": "Backward Resisted Treadmill or Sled Drag",
          "sets": 1,
          "reps": "180",
          "type": "time",
          "notes": "3 minutes at easy-to-moderate resistance."
        },
        {
          "id": "b-w02",
          "name": "Dynamic Leg Swings",
          "sets": 1,
          "reps": "8",
          "type": "reps",
          "perSide": true
        },
        {
          "id": "b-w03",
          "name": "Glute Bridge",
          "sets": 1,
          "reps": "10-12",
          "type": "reps"
        },
        {
          "id": "b-w04",
          "name": "Side-Lying Hip Abduction",
          "sets": 1,
          "reps": "12",
          "type": "reps",
          "perSide": true
        },
        {
          "id": "b-w05",
          "name": "Bird Dog",
          "sets": 1,
          "reps": "5-6",
          "type": "reps",
          "perSide": true,
          "notes": "Pause for approximately 2 seconds."
        },
        {
          "id": "b-w06",
          "name": "Bodyweight Hip Hinge",
          "sets": 1,
          "reps": "8",
          "type": "reps",
          "notes": "Perform controlled repetitions."
        },
        {
          "id": "b-w07",
          "name": "Deadlift Ramp-Up Sets",
          "sets": "2-4",
          "reps": "3-8",
          "type": "reps",
          "notes": "Progressively increase toward working weight without fatigue."
        }
      ],
      "exercises": [
        {
          "id": "b-01",
          "name": "Trap-Bar Deadlift or Conventional Deadlift",
          "alternatives": ["Trap-Bar Deadlift", "Conventional Deadlift"],
          "sets": 3,
          "reps": "4-6",
          "rest": 180,
          "type": "reps",
          "notes": "Main strength movement. Keep 1–3 reps in reserve."
        },
        {
          "id": "b-02",
          "name": "Assisted ATG Split Squat",
          "sets": "2-3",
          "reps": "6-10",
          "rest": 90,
          "type": "reps",
          "perSide": true,
          "notes": "Use stable support. An elevated front foot is acceptable. Keep the whole front foot planted and allow the knee to travel forward under control. Progress range, depth, reduced assistance, then load. Do not turn it into a balance test."
        },
        {
          "id": "b-03",
          "name": "Overhead Press",
          "sets": 3,
          "reps": "5-8",
          "rest": 120,
          "type": "reps"
        },
        {
          "id": "b-04",
          "name": "Chest-Supported Row",
          "sets": 3,
          "reps": "8-12",
          "rest": 90,
          "type": "reps"
        },
        {
          "id": "b-05",
          "name": "Lat Pulldown",
          "sets": 2,
          "reps": "8-12",
          "rest": 90,
          "type": "reps"
        },
        {
          "id": "b-06",
          "name": "45° Back Extension",
          "sets": 2,
          "reps": "10-15",
          "rest": 75,
          "type": "reps",
          "notes": "Controlled movement. Avoid excessive lumbar extension."
        },
        {
          "id": "b-07",
          "name": "Pallof Press",
          "sets": 2,
          "reps": "8-12",
          "rest": 60,
          "type": "reps",
          "perSide": true,
          "notes": "Resist trunk rotation."
        },
        {
          "id": "b-08",
          "name": "Seated / Bent-Knee Calf Raise",
          "sets": 2,
          "reps": "12-20",
          "rest": 60,
          "type": "reps"
        }
      ]
    },
    {
